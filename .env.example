# ============================================================
# Local development only.
# On Vercel these live in Project Settings -> Environment
# Variables, never in the repo.
# ============================================================

PORT=4000

# ---- GitHub (live PR counts + contribution calendar) --------
# Fine-grained Personal Access Token, READ-ONLY, no scopes needed
# for public data. Server-side only: a token in frontend JS is a
# public token.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Contact endpoint (api/contact.js) ----------------------
# Currently unused by the UI — the page shows the email address
# with a copy button instead. Kept configured so a contact form
# can be reinstated without any backend work.
# Gmail: use an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=your_app_password
CONTACT_TO=tahleelshaikh404@gmail.com
